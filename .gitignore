# Generated artifacts — recreate with `make run`.
# We deliberately keep these out of git so reviewers see a clean
# checkout and rebuild from source.
traces/data/
experiments/plots/

# But keep the real-trace seed files (small, committed by hand).
!traces/real/*.txt
!traces/real/*.txt.gz
